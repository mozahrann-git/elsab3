rules_version = '2';
// صور وفيديوهات وفويسات الموقع (بدل Cloudinary)
service firebase.storage {
  match /b/{bucket}/o {
    match /elsab3/{all=**} {
      // الصور والفيديوهات بتتعرض للزوار على الموقع
      allow read: if true;
      // الرفع: أي حد داخل (حتى الدخول المجهول بتاع عروض الملاك)، بحد أقصى ٢٠٠ ميجا،
      // وصور/فيديو/صوت بس
      allow create: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*');
      allow update, delete: if false;
    }
  }
}
