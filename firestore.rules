rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- مين بيطلب؟ ----------
    function signedIn()   { return request.auth != null; }
    function staffEmail() { return request.auth.token.email.lower(); }
    function isRealUser() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'password'; }
    function acc()        { return get(/databases/$(database)/documents/staff_access/$(staffEmail())).data; }
    function hasAccess()  { return isRealUser() && exists(/databases/$(database)/documents/staff_access/$(staffEmail())); }
    function roleIs(r)    { return hasAccess() && acc().role == r; }
    function isAdmin()    { return roleIs('admin'); }
    function isStaff()    { return hasAccess() && acc().role in ['admin', 'sales']; }
    function isCoord()    { return roleIs('coordinator'); }
    function isOps()      { return hasAccess() && acc().role in ['admin', 'coordinator']; }
    function isBroker()   { return roleIs('broker'); }
    function isBoss()     { return roleIs('company_owner'); }   // أونر الشركة: عرض بس
    function isMkt()      { return roleIs('marketing'); }
    function isOwner()    { return roleIs('owner'); }
    /* صلاحية تعديل الشقق: الأدمن والمنسقة دايماً، وأي حساب
       سيلز الأدمن داله الصلاحية صراحة من شاشة الحسابات.
       قبل كده كان أي سيلز يقدر يعدّل أي شقة — دي كانت واسعة. */
    function canEditProps() { return isAdmin() || isCoord()
                              || (roleIs('sales') && acc().canEditProperties == true); }
    function myBrokerId() { return acc().brokerId; }
    function myCodes()    { return acc().propertyCodes; }
    function onlyKeys(k)  { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(k); }

    // ---------- الحسابات ----------
    match /staff_access/{email} {
      allow read: if isRealUser() && (staffEmail() == email || isAdmin() || isCoord() || isBoss());
      allow write: if isAdmin();
      // صاحب الحساب يغيّر الباسوورد بس
      allow update: if isRealUser() && staffEmail() == email && onlyKeys(['password', 'updatedAt']);
      // المالك (@owner.com) والبروكر (@broker.com) بيعملوا حسابهم بنفسهم من غير وحدات
      allow create: if isRealUser() && staffEmail() == email && request.resource.data.propertyCodes.size() == 0
                    && ((request.resource.data.role == 'owner' && email.matches('.*@owner[.]com$'))
                        || (request.resource.data.role == 'broker' && email.matches('.*@broker[.]com$')
                            && request.resource.data.brokerId == email.split('@')[0]));
      // مسؤولة الملاك تربط وحدة بمالكها
      allow update: if isCoord() && resource.data.role == 'owner' && onlyKeys(['propertyCodes']);
    }

    // ---------- الشقق ----------
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update: if canEditProps();
      /* الحذف: الأدمن + السيلز اللي متعلّم له «يعدّل الشقق» */
      allow delete: if canEditProps();
      // البروكر بيحدّث صور وحدته بس
      allow update: if isBroker() && resource.data.brokerId == myBrokerId() && onlyKeys(['images']);
      /* عدّاد المشاهدات والواتساب والاتصال: الزائر العادي بيحرّكه،
         وده كان مرفوض خالص لأن القاعدة فوق بتطلب موظف — فالأرقام
         كانت بتفضل صفر والإحصائيات غلط. مسموح بالعدّاد بس،
         ولا حاجة تانية في الشقة تتغيّر. */
      allow update: if onlyKeys(['clicks']);
      match /private/{docId} {
        allow read, write: if isStaff() || isCoord();
        // البروكر يسجّل رقم المالك (ميقدرش يقراه تاني)
        allow create, update: if isBroker() && request.resource.data.brokerId == myBrokerId();
      }
    }

    match /sales_agents/{agentId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isStaff();
    }

    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /closed_deals/{dealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* سجل المهام: مكالمات بنتيجتها وإعلانات بسكرين شوت.
       الفريق بيسجّل ويقرا، والإدارة بس اللي بتمسح — عشان محدش
       يشيل تسجيلة بعد ما الإدارة تراجعها. */
    match /quest_logs/{id} {
      allow read: if isStaff() || isOps() || isBoss() || isMkt();
      allow create: if isStaff() || isOps();
      allow update, delete: if isAdmin();
    }

    /* لمسات الإحالة: الزائر لسه مش مسجّل دخول، فلازم يقدر يكتب لمسته.
       بس القراءة للفريق بس — ومحدش يقدر يغيّر أو يمسح لمسة اتسجّلت،
       عشان حد ما يسرقش إحالة غيره. */
    match /ref_touches/{id} {
      allow read: if isStaff() || isOps() || isBoss() || isMkt();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    /* اللينكات المبعوتة: السيلز بيسجّل بعت لمين، عشان يعرف بعدين
       فتح ولا لأ. الزائر مبيكتبش هنا خالص — الفتح بيتسجّل في
       ref_touches وإحنا بنطابق بالتوكن. */
    match /sent_links/{id} {
      allow read: if isStaff() || isOps() || isBoss() || isMkt();
      allow create, update: if isStaff() || isOps();
      allow delete: if isStaff() || isOps();
    }

    match /crm_leads/{leadId} {
      /* البق اللي كان واقف المزامنة: القراءة كانت لـ company_owner بس.
         يعني الإدارة والسيلز مكانوش يقدروا يقروا العملاء أصلاً — الاتصال
         بيترفض، وكل جهاز بيفضل على النسخة المخزّنة عنده، فكل واحد يشوف
         حاجة. كل المجموعات التانية ليها سطر قراءة للفريق إلا دي. */
      allow read: if isStaff() || isOps() || isBoss() || isMkt();
      allow create: if true;
      allow delete: if isAdmin();

      // الإدارة بتعدّل أي حاجة
      allow update: if isAdmin();

      /* السيلز بيعدّل كل حاجة ما عدا الميزانية المعتمدة.
         عايز يغيّرها؟ بيسيبها زي ما هي وبيبعت budgetChangeRequest،
         والإدارة هي اللي بتغيّرها فعلاً. الفلتر في الواجهة مش كفاية لوحده. */
      allow update: if isStaff()
        && (
          // أول مرة تتحط: مسموح
          resource.data.get('budgetMax', 0) == 0
          // بعد كده: لازم تفضل زي ما هي
          || (request.resource.data.get('budgetMin', 0) == resource.data.get('budgetMin', 0)
              && request.resource.data.get('budgetMax', 0) == resource.data.get('budgetMax', 0))
        );
    }

    match /owner_submissions/{id} {
      allow read: if isBoss();
      allow create: if true;
      allow read: if isStaff() || isCoord() || (isRealUser() && resource.data.ownerEmail == staffEmail());
      allow update: if isStaff() || isCoord();
      allow delete: if isAdmin();
    }

    match /viewing_requests/{id} {
      allow read: if isBoss();
      allow create: if true;
      allow read, update: if isStaff() || isCoord();
      allow delete: if isAdmin();
    }

    // دليل الأحياء: الكل يقرا، الأدمن يعدّل
    match /district_guides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // المشاريع تحت الإنشاء: الزوار بيقروا، الأدمن بس اللي بيضيف ويعدّل ويمسح
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
      /* المطور واللوكيشن والعنوان والملاحظات الداخلية.
         الفريق بيقراها عشان يشتغل بيها، والزائر لأ — وده اللي بيمنعه
         يروح للمطور على طول. الأدمن بس اللي بيكتب. */
      match /private/{docId} {
        allow read: if isStaff() || isOps() || isBoss() || isMkt();
        allow write: if isAdmin();
      }
    }

    // ---------- بوابات الملاك والبروكرز ----------
    match /unit_viewings/{id} {
      allow read: if isBoss();
      allow read, create, update, delete: if isOps();
      allow read: if isStaff()
                  || (isOwner() && resource.data.propertyCode in myCodes())
                  || (isBroker() && resource.data.brokerId == myBrokerId());
      allow update: if isOwner() && resource.data.propertyCode in myCodes()
                    && onlyKeys(['ownerStatus', 'ownerNote', 'ownerRespondedAt']);
      allow update: if isBroker() && resource.data.brokerId == myBrokerId()
                    && onlyKeys(['brokerStatus', 'brokerConfirmedTime', 'brokerConfirmedAt', 'ownerStatus']);
    }

    match /owner_feedback/{id} {
      allow read: if isBoss();
      allow read, write: if isOps() || isStaff();
      allow read: if (isOwner() && resource.data.propertyCode in myCodes())
                  || (isBroker() && resource.data.brokerId == myBrokerId());
    }

    match /change_requests/{id} {
      allow read: if isBoss();
      allow read, update: if isOps();
      allow read: if isRealUser() && resource.data.requesterEmail == staffEmail();
      allow create: if isRealUser() && request.resource.data.requesterEmail == staffEmail()
                    && request.resource.data.status == 'pending'
                    && ((isOwner() && request.resource.data.propertyCode in myCodes())
                        || (isBroker() && request.resource.data.brokerId == myBrokerId()));
    }

    // ---------- فيدباك البروكر: للسيلز اللي طلب المعاينة والإدارة بس ----------
    match /broker_feedback/{id} {
      allow read: if isBoss();
      allow create: if isBroker() && request.resource.data.brokerId == myBrokerId();
      allow read: if isOps()
                  || (isBroker() && resource.data.brokerId == myBrokerId())
                  || (isStaff() && get(/databases/$(database)/documents/sales_agents/$(resource.data.salesAgentId)).data.email.lower() == staffEmail());
    }

    // ---------- أدوات السيلز: العروض واللينكات والمحتوى ----------
    match /offers/{id} {
      allow get: if true;                 // لينك العرض نفسه
      allow update: if true;              // عدّاد الفتح بس
      allow list, create, delete: if isStaff() || isOps() || isBoss();
    }
    match /tracked_links/{id} {
      allow get: if true;
      allow update: if true;              // عدّادات الفتح والواتساب
      allow list, create, delete: if isStaff() || isOps() || isBoss() || isMkt();
    }
    match /content_slots/{id} {
      allow read: if isStaff() || isOps() || isBoss() || isMkt();
      allow create, update: if isStaff() || isOps() || isMkt();
      allow delete: if isAdmin();
    }

    // ---------- مندوبين المعاينات ----------
    match /field_agents/{id} {
      // مستند واحد بالـ id: لازمة لصفحة نداء الصباح اللي بتفتح من غير تسجيل دخول
      allow get: if true;
      allow read: if isBoss();
      allow read: if isOps() || isStaff();
      allow write: if isAdmin();
      allow update: if isOps() || isStaff();   // الدور والعدادات
    }
    match /field_trips/{id} {
      allow read: if isBoss();
      allow get: if true;                      // الـ id نفسه هو لينك الفيدباك
      allow list, create, update, delete: if isOps();
    }
    /* زيارات الوحدات: المجموعة دي مكانش ليها قاعدة خالص، فالقاعدة الأخيرة
       في الملف (allow read, write: if false) كانت بترفض كل كتابة وقراءة
       فيها من أول يوم. ولا زيارة واحدة اتسجّلت — وعشان كده بوابة البروكر
       والمالك بيقولوا "صفر زائر" دايماً.
       الكتابة مفتوحة زي events (الزائر مش مسجّل دخول)، والقراءة للموظفين
       وللبروكر على وحداته وللمالك على أكواده. */
    match /unit_visits/{id} {
      allow create, update: if true;
      allow read: if isStaff() || isOps() || isBoss() || isMkt()
                  || (isBroker() && request.auth != null)
                  || (isOwner() && request.auth != null);
      allow delete: if isAdmin();
    }

    /* الإعدادات — منها أهداف المهام اليومية.
       من غير القاعدة دي كانت هتترفض في صمت بسبب قاعدة المنع
       العامة في آخر الملف، والأهداف تفضل على الافتراضي
       من غير ما حد ياخد باله. */
    match /settings/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isBoss();
    }

    // سجل الأحداث: الكتابة مفتوحة (الزائر بيسجّل مشاهداته)، القراءة للإدارة بس
    match /events/{id} {
      allow create: if true;
      allow read: if isOps() || isStaff() || isBoss() || isMkt();
      allow update, delete: if isAdmin();
    }

    // نداء الصباح: المندوب بيأكد من لينك من غير تسجيل دخول، فالكتابة مفتوحة
    // بس على مستند اليوم بتاعه بالظبط، والقراءة للإدارة ومسؤولة الملاك بس
    match /field_checkins/{id} {
      allow read: if isOps() || isStaff() || isBoss();
      allow create, update: if exists(/databases/$(database)/documents/field_agents/$(request.resource.data.agentId))
                            && id == request.resource.data.agentId + '_' + request.resource.data.day;
      allow delete: if isAdmin();
    }

    match /field_feedback/{id} {
      allow read: if isBoss();
      allow read, update: if isOps();
      // السيلز بيشوف ويأكد فيدباك المعاينات اللي هو طلبها بس — مش فيدباك زمايله
      allow read, update: if isStaff()
                          && resource.data.salesAgentId is string
                          && get(/databases/$(database)/documents/sales_agents/$(resource.data.salesAgentId)).data.email.lower() == staffEmail();
      allow create: if exists(/databases/$(database)/documents/field_trips/$(request.resource.data.tripId))
                    && request.resource.data.stage == 'submitted';
      /* الفيدباك اللي اترفض المندوب يبعته تاني من نفس اللينك */
      allow update: if resource.data.stage == 'rejected'
                    && request.resource.data.stage == 'submitted'
                    && request.resource.data.tripId == resource.data.tripId;
      allow delete: if isOps();
    }

    // ---------- المهام اليومية للسيلز ----------
    /* أرقام المكالمات: الإدارة بترفعها وبتوزعها، والسيلز بيسجّل
       النتيجة بس — مايقدرش يغيّر الرقم ولا مين متوزع عليه */
    match /call_list/{id} {
      allow read: if isStaff() || isBoss();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isStaff() && onlyKeys(['status', 'attempts', 'lastAt', 'lastDay', 'lastBy', 'lastNote', 'leadId']));
    }
    /* عدّاد يوم كل سيلز. الإجازة الإدارة بس اللي تحطها */
    match /sales_daily/{id} {
      allow read: if isStaff() || isBoss();
      allow create: if isStaff() && id == request.resource.data.agentId + '_' + request.resource.data.day
        && (isAdmin() || request.resource.data.get('off', false) == false);
      allow update: if isStaff() && id == request.resource.data.agentId + '_' + request.resource.data.day
        && (isAdmin() || request.resource.data.get('off', false) == resource.data.get('off', false));
      allow delete: if isAdmin();
    }
    /* سكرين شوت الإعلانات: السيلز بيرفع، والإدارة بتقبل أو ترفض.
       المرفوض السيلز يقدر يرفعه تاني */
    match /ad_posts/{id} {
      allow read: if isStaff() || isBoss();
      allow create: if isStaff() && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isStaff() && resource.data.status == 'rejected' && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // ---------- قديم ----------
    match /brokers/{id} {
      allow read: if isBoss();
      allow read: if isStaff() || isCoord() || (isBroker() && id == myBrokerId());
      allow write: if isStaff();
    }
    match /viewing_feedbacks/{id} {
      allow read: if isBoss();
      allow read, write: if isStaff() || isCoord();
    }
    match /portal_users/{id}         { allow read, write: if isAdmin(); }
    match /governance_audit_logs/{id} {
      allow create: if isStaff();
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
